# All keys are OPTIONAL and FREE. Copy this file to .env and fill in what you have.

# TfL — works without a key (50 req/min shared). Free key = 500 req/min.
# Register: https://api-portal.tfl.gov.uk (subscribe to "500 Requests per min")
TFL_APP_KEY=

# National Rail live boards (platforms, delays, cancellations).
# Register: https://raildata.org.uk -> subscribe to "Live Departure Board"
# product -> copy the Consumer key. Free up to 5M requests / 4 weeks.
DARWIN_API_KEY=
# Override only if your RDM product uses a different path:
# DARWIN_BASE_URL=https://api1.raildata.org.uk/1010-live-departure-board-dep1_2/LDBWS/api/20220120

# Live bus GPS for all of England (10s refresh).
# Register: https://data.bus-data.dft.gov.uk/account/signup/ -> Account settings -> API key
BODS_API_KEY=
